# shellcheck shell=bash disable=SC2034
# VDI-ImageMaint for Linux - customer configuration.
# Copy to vdi-imagemaint.conf (git-ignored) and adjust. Every setting and its
# default is listed in conf/defaults.conf; set here only what differs.

PROFILE="university"              # university | business
VDI_LANG=""                       # en-US | pl-PL | empty = from $LANG

# Active Directory (SSSD on the golden image; Horizon clones the join)
AD_DOMAIN="ad.example.edu"
AD_WORKGROUP="AD"
AD_JOIN_USER="join.example"
AD_COMPUTER_OU="OU=VDI-Linux,OU=Computers,DC=ad,DC=example,DC=edu"
AD_ACCESS_GROUPS="VDI-Linux-Users"
AD_SUDO_GROUPS="VDI-Linux-Admins"
SSSD_ID_MAPPING="true"            # must give the same UIDs as the NFS server sees

# Certificate logon (put the CA PEM files in certs/)
TRUESSO_ENABLE="no"
SMARTCARD_ENABLE="no"
CERT_CA_FILES="enterprise-root-ca.pem enterprise-issuing-ca.pem"

# USB redirection (USB 3.0, VHCI driver), FIDO2 via USB, audio-in
USB_ENABLE="yes"
FIDO_ENABLE="no"
AUDIO_IN_ENABLE="yes"

# NFS home directories
NFS_ENABLE="yes"
NFS_SERVER="nfs.example.edu"
NFS_EXPORT="/export/home"
NFS_SEC="krb5p"

# Horizon Linux Agent (put Omnissa-horizonagent-linux-x86_64-*.tar.gz in Horizon/)
HORIZON_CS_FQDN=""                # e.g. "cs01.ad.uni.edu cs02.ad.uni.edu" - checked for DNS resolution

# Horizon Recording (put Horizon.Recording.Linux.Agent-*.tar.gz in Horizon/)
REC_ENABLE="no"
REC_SERVER_URL="https://rec.example.edu:9443"
REC_USERNAME="rec-register"

# Session Collaboration (mode "collab" asks; these are the offered defaults)
COLLAB_SERVER_URL="https://uag.example.edu"
